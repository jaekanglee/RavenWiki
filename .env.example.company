# Raven — 회사 맥북 프로필 템플릿
# 망분리된 사내망, 사용자 = 나 + 팀원(사내 LAN) + 나(Tailscale 원격).
#
# 적용: cp .env.example.company .env && ./raven.sh restart
# 주의: 이 머신의 vault 데이터가 ~/Raven이 아니면 RAVEN_VAULTS_DIR을 직접 수정할 것.

RAVEN_VAULTS_DIR=${HOME}/Raven

# MCP 권한 모드: read | write | admin
RAVEN_MCP_MODE=admin

# admin 포트(8766)는 나만 — Tailscale 인터페이스로만 바인딩 (사내 LAN에서는 안 보임).
# $(tailscale ip -4)는 raven.sh가 `source`로 읽기 때문에 매 기동 시 동적으로 평가됨
# (Tailscale IP가 바뀌어도 이 파일을 수정할 필요 없음).
RAVEN_MCP_HOST=$(tailscale ip -4)
RAVEN_DASHBOARD_HOST=0.0.0.0

# 팀원용 write 전용 인스턴스 (8767, 사내 LAN 전체 노출) — delete/rename 없음.
RAVEN_MCP_TEAM_ENABLE=true
RAVEN_MCP_TEAM_MODE=write
RAVEN_MCP_TEAM_HOST=0.0.0.0
