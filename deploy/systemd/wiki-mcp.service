[Unit]
Description=Wiki MCP Server (HTTP transport)
After=network.target
Documentation=https://github.com/<user>/wiki

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/home/%i/wiki

Environment=VAULT=/home/%i/wiki
Environment=PYTHONUNBUFFERED=1

# HTTP transport on localhost:8765 (Tailscale reverse proxy로 외부 노출)
ExecStart=/home/%i/wiki/scripts/.venv/bin/python -m mcp.cli --transport http --host 127.0.0.1 --port 8765

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wiki-mcp

[Install]
WantedBy=multi-user.target
