# Raven — 집 맥북 프로필
# 일반 벤더사 회선 (망분리 X, 신뢰 안 되는 망), 사용자 = 나 혼자.
# 외부 접근은 반드시 Tailscale — 집 와이파이의 다른 기기에는 노출되지 않음.
#
# 적용: cp .env.house .env && ./raven.sh restart
# 주의: 이 머신의 vault 데이터가 ~/Raven이 아니면 RAVEN_VAULTS_DIR을 직접 수정할 것.

RAVEN_VAULTS_DIR=${HOME}/Raven

# 나 혼자 쓰는 머신이라 admin으로 둬도 무방.
RAVEN_MCP_MODE=admin

# $(tailscale ip -4): raven.sh가 `source`로 읽어 매 기동 시 동적으로 평가됨 —
# 이 머신의 실제 Tailscale IP로 자동 바인딩 (0.0.0.0 금지: 집 와이파이 노출 방지).
RAVEN_MCP_HOST=$(tailscale ip -4)
RAVEN_DASHBOARD_HOST=$(tailscale ip -4)

# 집에서는 팀원 없음 — team 인스턴스 불필요.
RAVEN_MCP_TEAM_ENABLE=false
