CREATE TABLE Document (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    path TEXT,
    isFavorite INTEGER AS kotlin.Boolean DEFAULT 0,
    lastUpdated INTEGER NOT NULL
);

selectAll:
SELECT id, title, content, path, isFavorite, lastUpdated FROM Document;

selectById:
SELECT id, title, content, path, isFavorite, lastUpdated FROM Document WHERE id = ?;

insertDocument:
INSERT OR REPLACE INTO Document(id, title, content, path, isFavorite, lastUpdated)
VALUES (?, ?, ?, ?, ?, ?);

toggleFavorite:
UPDATE Document SET isFavorite = 1 - isFavorite WHERE id = ?;

deleteDocument:
DELETE FROM Document WHERE id = ?;

CREATE TABLE PendingWrite (
    slug TEXT NOT NULL PRIMARY KEY,
    operation TEXT NOT NULL,
    payload TEXT,
    attemptCount INTEGER NOT NULL DEFAULT 0,
    lastError TEXT,
    failureKind TEXT
);

selectPendingWrites:
SELECT slug, operation, payload, attemptCount, lastError, failureKind
FROM PendingWrite
ORDER BY rowid;

enqueuePendingWrite:
INSERT OR REPLACE INTO PendingWrite(slug, operation, payload, attemptCount, lastError, failureKind)
VALUES (?, ?, ?, 0, NULL, NULL);

recordPendingWriteFailure:
UPDATE PendingWrite
SET attemptCount = attemptCount + 1,
    lastError = ?,
    failureKind = ?
WHERE slug = ?;

removePendingWrite:
DELETE FROM PendingWrite WHERE slug = ?;

CREATE TABLE Settings (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

getSetting:
SELECT value FROM Settings WHERE key = ?;

setSetting:
INSERT OR REPLACE INTO Settings(key, value) VALUES (?, ?);
