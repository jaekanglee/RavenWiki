# Raven — multi-vault wiki engine
#
# Docker quick start (다른 PC에서도 동일):
#   cp .env.example .env && vi .env  # 포트/경로 조정
#   docker compose up --build       # build + run 4 services
#   open http://localhost:5173      # Dashboard
#   curl http://localhost:8765/api/vaults  # API
#
# 로컬 개발 (host에서 직접):
#   make install
#   make dev
#
# 4 진입점 ports (커스터마이즈 가능)
# ----------------------------------------------------------------------------

PORT_API=8765
PORT_MCP_HTTP=8766
PORT_DASHBOARD=5173

# 외부 접속 (Tailscale 등) — 0.0.0.0 으로 띄움. 로컬만 = 127.0.0.1.
HOST=0.0.0.0

# Vault 데이터 위치 (Docker volume 또는 host 경로).
# v0.7.19+: 기본값 = 호스트 ~/Raven (사용자 vault 표준 위치).
# 다른 PC에서는 본인 홈 경로로 변경 (예: /Users/alice/Raven).
RAVEN_VAULTS_DIR=${HOME}/Raven

# v0.7.9+ 에이전트 표준 프로토콜 = MCP only.
# Multi-agent 동시 write = experimental (locks/queue/review 없음).
# ----------------------------------------------------------------------------
