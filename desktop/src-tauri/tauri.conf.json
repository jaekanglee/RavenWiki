{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raven",
  "version": "0.1.0",
  "identifier": "com.raven.local",
  "build": {
    "beforeBuildCommand": "cd ../dashboard && npm run build",
    "beforeDevCommand": "cd ../dashboard && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../dashboard/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Raven",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/python/**/*",
      "resources/raven/**/*"
    ]
  }
}
